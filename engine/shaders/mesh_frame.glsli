// Keep in sync with kMaxForwardLights in engine/include/render/RenderLight.h.
const uint MAX_LIGHTS = 64u;

struct GpuLight
{
    vec4 PositionRange;
    vec4 DirectionCone;
    vec4 ColorIntensity;
    uint Type;
    uint ShadowIndex;
    float ConeScale;
    float ConeOffset;
};

layout(set = 0, binding = 0) uniform MeshFrame
{
    mat4 ViewProjection;
    vec4 ViewPositionTime;
    vec4 AmbientSky;
    vec4 AmbientGround;
    vec4 StyleParams; // diffuse wrap, minimum ambient, exposure, tonemap knee
    uint LightCount;
    uint TonemapEnabled;
    uint Pad0;
    uint Pad1;
    GpuLight Lights[MAX_LIGHTS];
} frame;
