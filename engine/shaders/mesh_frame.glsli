// Keep these caps in sync with engine/include/render/RenderLight.h.
const uint MAX_LIGHTS = 64u;
const uint MAX_SPOT_SHADOWS = 8u;
const uint MAX_POINT_SHADOWS = 4u;

// RGBM multiplier for the baked-static-direct vertex channel. Must match the
// encoder in the lighting bake (engine-side DirectLightBakeMath).
const float BAKED_DIRECT_RANGE = 16.0;

struct GpuLight
{
    vec4 PositionRange;
    vec4 DirectionCone;
    vec4 ColorIntensity;
    uint Type;
    uint ShadowIndex;
    float ConeScale;
    float ConeOffset;
};

struct GpuSpotShadow
{
    mat4 ViewProjection;
    vec4 AtlasScaleBias;
    vec4 SamplingParams; // world texel size, softness in texels, bias scale, unused
};

// State the cube faces were rendered with; the cube array layer is the
// record's own index.
struct GpuPointShadow
{
    vec4 PositionFar; // rendered light position, far plane
    vec4 Params;      // near plane, softness in texels, bias scale, unused
};

layout(set = 0, binding = 0) uniform MeshFrame
{
    mat4 ViewProjection;
    vec4 ViewPositionTime;
    vec4 AmbientSky;
    vec4 AmbientGround;
    vec4 StyleParams; // diffuse wrap, minimum ambient, exposure, tonemap knee
    uint LightCount;
    uint TonemapEnabled;
    float ShadowDarkness;
    uint BakedDirectEnabled; // 1 = add the baked-static-direct vertex term.
    GpuLight Lights[MAX_LIGHTS];
    uint SpotShadowCount;
    uint ShadowPad0;
    uint ShadowPad1;
    uint ShadowPad2;
    GpuSpotShadow SpotShadows[MAX_SPOT_SHADOWS];
    uint PointShadowCount;
    uint PointShadowPad0;
    uint PointShadowPad1;
    uint PointShadowPad2;
    GpuPointShadow PointShadows[MAX_POINT_SHADOWS];
    uint DebugView;
    uint DebugViewPad0;
    uint DebugViewPad1;
    uint DebugViewPad2;
} frame;
