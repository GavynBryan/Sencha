// Keep these caps in sync with engine/include/render/RenderLight.h.
const uint MAX_LIGHTS = 64u;
const uint MAX_SPOT_SHADOWS = 8u;

struct GpuLight
{
    vec4 PositionRange;
    vec4 DirectionCone;
    vec4 ColorIntensity;
    uint Type;
    uint ShadowIndex;
    float ConeScale;
    float ConeOffset;
};

struct GpuSpotShadow
{
    mat4 ViewProjection;
    vec4 AtlasScaleBias;
    vec4 SamplingParams; // world texel size, softness in texels, bias scale, unused
};

layout(set = 0, binding = 0) uniform MeshFrame
{
    mat4 ViewProjection;
    vec4 ViewPositionTime;
    vec4 AmbientSky;
    vec4 AmbientGround;
    vec4 StyleParams; // diffuse wrap, minimum ambient, exposure, tonemap knee
    uint LightCount;
    uint TonemapEnabled;
    float ShadowDarkness;
    uint Pad1;
    GpuLight Lights[MAX_LIGHTS];
    uint SpotShadowCount;
    uint ShadowPad0;
    uint ShadowPad1;
    uint ShadowPad2;
    GpuSpotShadow SpotShadows[MAX_SPOT_SHADOWS];
} frame;
