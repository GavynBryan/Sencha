// Mirrored by BloomPush in BloomPass.cpp.

layout(location = 0) in vec2 vUv;
layout(location = 0) out vec4 outColor;

layout(set = 0, binding = 0) uniform sampler2D uTextures[1024];

layout(push_constant) uniform BloomPC {
    uint sourceIndex;
    uint sceneIndex; // 0xFFFFFFFF composites over what the target holds
    float threshold;
    float intensity;
    float radius;
    uint gather; // source texels per axis one glow texel covers
    vec2 texel;
} pc;
