@font-face { src: "fonts/Inter-Regular.ttf"; }

/* The shell's own chrome: the rail and its popovers. Geometry only; every
   colour comes from theme.rcss roles. The whole document passes the pointer
   through except where something is actually mounted. */

body
{
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    font-family: Inter;
    font-size: 12dp;
}

#rail
{
    display: flex;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 34dp;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1dp;
    pointer-events: auto;
}

#rail_left, #rail_right
{
    display: flex;
    align-items: center;
    height: 34dp;
    padding: 0dp 6dp;
    gap: 6dp;
}

#notices
{
    display: flex;
    position: relative;
    flex: 1;
    justify-content: center;
    align-items: center;
    height: 34dp;
    pointer-events: none;
}

/* Behind the notices, which pass over it. */
#grille
{
    display: flex;
    position: absolute;
    left: 50%;
    top: 11dp;
    width: 108dp;
    height: 12dp;
    margin-left: -54dp;
    align-items: center;
    gap: 6dp;
}

.screw { display: block; width: 12dp; height: 12dp; }
.vent { display: block; width: 72dp; height: 12dp; }

.notice
{
    display: block;
    height: 20dp;
    line-height: 20dp;
    padding: 0dp 10dp;
    margin: 0dp 4dp;
    border-width: 1dp;
    border-radius: 3dp;
    font-family: "JetBrains Mono";
    font-size: 11dp;
}

.dial
{
    display: flex;
    align-items: center;
    height: 24dp;
    padding: 0dp 10dp 0dp 3dp;
    gap: 7dp;
    border-width: 1dp;
    border-radius: 12dp;
    pointer-events: auto;
    tab-index: auto;
}

.knob
{
    display: block;
    width: 18dp;
    height: 18dp;
    border-width: 1dp;
    border-radius: 9dp;
}

.dial_label
{
    display: block;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 12dp;
    letter-spacing: 1dp;
}

.lamp
{
    display: block;
    width: 8dp;
    height: 8dp;
    border-width: 1dp;
    border-radius: 4dp;
}

.readout
{
    display: flex;
    align-items: center;
    gap: 5dp;
    height: 22dp;
    padding: 0dp 7dp;
    border-width: 1dp;
    border-radius: 3dp;
    font-family: "JetBrains Mono";
    pointer-events: auto;
}

#transport
{
    display: flex;
    align-items: center;
    gap: 4dp;
    height: 26dp;
    padding: 0dp 4dp;
    border-width: 1dp;
    border-radius: 4dp;
    pointer-events: auto;
}

#cat_Transport { padding: 0dp 6dp; border-right-width: 0dp; }

.transport_text
{
    display: block;
    max-width: 220dp;
    overflow: hidden;
    padding: 0dp 4dp;
    font-family: "JetBrains Mono";
    font-size: 11dp;
}

#window_keys
{
    display: flex;
    gap: 3dp;
    margin-left: 6dp;
}

#dismiss
{
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
}

#popover
{
    display: block;
    position: absolute;
    top: 38dp;
    width: 280dp;
    padding: 4dp 0dp;
    border-width: 1dp;
    border-radius: 4dp;
    pointer-events: auto;
}

/* From a bottom instrument, a popover rises over it instead. */
#popover.rising
{
    top: auto;
    bottom: 52dp;
}

.entry
{
    display: flex;
    justify-content: space-between;
    height: 24dp;
    line-height: 24dp;
    padding: 0dp 12dp;
}

.entry.heading
{
    height: 20dp;
    line-height: 20dp;
    margin-top: 4dp;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 10dp;
    letter-spacing: 2dp;
    pointer-events: none;
}

.entry.disabled
{
    pointer-events: none;
}

.entry_icon { width: 16dp; height: 16dp; margin: 4dp 8dp 0dp 0dp; }
.entry_label { display: block; flex: 1; }

.entry_chord
{
    display: block;
    font-family: "JetBrains Mono";
    font-size: 11dp;
}

/* The station and its card, bottom left: the operation in hand and what it
   is set to. */
#instruments_left
{
    display: flex;
    position: absolute;
    left: 8dp;
    bottom: 8dp;
    align-items: flex-end;
    gap: 8dp;
    pointer-events: none;
}

#station_bay
{
    display: flex;
    flex-direction: column;
    width: 260dp;
    gap: 6dp;
    pointer-events: none;
}

#readout
{
    display: flex;
    height: 34dp;
    align-items: center;
    border-width: 1dp;
    border-radius: 4dp;
    font-family: "JetBrains Mono";
    font-size: 12dp;
    pointer-events: auto;
}

.segment
{
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0dp 10dp;
    gap: 6dp;
    border-right-width: 1dp;
}
.segment .lamp { width: 8dp; height: 8dp; border-width: 1dp; border-radius: 4dp; }

#instruments_right
{
    display: flex;
    position: absolute;
    right: 8dp;
    bottom: 8dp;
    pointer-events: none;
}

#instrument_row { display: flex; gap: 8dp; }

/* Above the bottom instruments as a card; along the right edge, from the rail
   down, as the drawer. */
#selection_card
{
    display: block;
    position: absolute;
    right: 8dp;
    bottom: 50dp;
    width: 280dp;
    max-height: 70%;
    overflow-y: auto;
    padding: 8dp 10dp;
    border-width: 1dp;
    border-radius: 4dp;
    opacity: 0;
    transform: translateY(10dp);
    pointer-events: none;
}
#selection_card.open { opacity: 1; transform: translateY(0dp); pointer-events: auto; }
#selection_card.shut * { pointer-events: none; }
.moving #selection_card { transition: opacity transform 0.14s cubic-out; }

#selection_card.drawer { top: 42dp; width: 360dp; max-height: none; }

#selection_head
{
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6dp;
}

#selection_chips, #drawer_chips
{
    display: flex;
    flex-wrap: wrap;
    gap: 4dp;
    margin-bottom: 6dp;
}

.setting.verb { height: 24dp; }

#selection_title
{
    display: block;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 12dp;
    letter-spacing: 1dp;
}

#selection_verbs
{
    display: flex;
    flex-wrap: wrap;
    gap: 4dp;
    margin-top: 8dp;
}

#holding
{
    display: flex;
    align-items: center;
    height: 34dp;
    padding: 0dp 4dp;
    gap: 6dp;
    border-width: 1dp;
    border-radius: 4dp;
    pointer-events: auto;
}

.cartridge
{
    display: flex;
    align-items: center;
    height: 100%;
    padding-right: 8dp;
    gap: 8dp;
    border-right-width: 1dp;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 12dp;
    letter-spacing: 1dp;
}

.picture_well
{
    display: block;
    width: 26dp;
    height: 26dp;
    border-width: 1dp;
    border-radius: 2dp;
}
.cartridge_label.empty { text-transform: uppercase; }
.picture { display: block; width: 100%; height: 100%; }

#stash { display: flex; gap: 4dp; }
.stash_slot { width: 20dp; height: 20dp; opacity: 0.55; }
.stash_slot.filled, .stash_slot:hover { opacity: 1; }

#cat_View
{
    display: flex;
    align-items: center;
    height: 34dp;
    padding: 0dp 12dp;
    gap: 10dp;
    border-width: 1dp;
    border-radius: 4dp;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 12dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
    pointer-events: auto;
}

#station
{
    display: flex;
    align-items: center;
    height: 34dp;
    padding: 0dp 12dp;
    gap: 8dp;
    border-width: 1dp;
    border-radius: 4dp;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 12dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
    pointer-events: auto;
}

.station_icon { width: 18dp; height: 18dp; }
.station_variant { font-size: 11dp; }

/* Shut, the card sits folded into its station: out of sight and out of
   reach. Open, it has risen out of it. */
#tool_card
{
    display: block;
    padding: 8dp 10dp;
    border-width: 1dp;
    border-radius: 4dp;
    opacity: 0;
    transform: translateY(10dp);
    pointer-events: none;
}
#tool_card.open { opacity: 1; transform: translateY(0dp); pointer-events: auto; }
#tool_card.shut * { pointer-events: none; }

/* Motion, while the person wants it (editor.ui.motion). Only transform and
   opacity move, so nothing reflows and input is never held up. */
.moving #tool_card { transition: opacity transform 0.14s cubic-out; }

#tool_hint { display: block; margin-top: 6dp; font-size: 11dp; }

#tool_keys
{
    display: flex;
    justify-content: flex-end;
    gap: 6dp;
    margin-top: 8dp;
}
