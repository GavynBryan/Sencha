@font-face { src: "fonts/Inter-Regular.ttf"; }
@font-face { src: "fonts/ChakraPetch-SemiBold.ttf"; }
@font-face { src: "fonts/JetBrainsMono-Regular.ttf"; }
@font-face { src: "fonts/fa-solid-900.ttf"; }

/* The shell's own chrome: the rail and its popovers. Geometry only; every
   colour comes from theme.rcss roles. The whole document passes the pointer
   through except where something is actually mounted. */

body
{
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    font-family: Inter;
    font-size: 12dp;
}

#rail
{
    display: flex;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 34dp;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1dp;
    pointer-events: auto;
}

#rail_left, #rail_right
{
    display: flex;
    align-items: center;
    height: 34dp;
    padding: 0dp 6dp;
    gap: 6dp;
}

#notices
{
    display: flex;
    position: relative;
    flex: 1;
    justify-content: center;
    align-items: center;
    height: 34dp;
    pointer-events: none;
}

/* Behind the notices, which pass over it. */
#grille
{
    display: flex;
    position: absolute;
    left: 50%;
    top: 11dp;
    width: 108dp;
    height: 12dp;
    margin-left: -54dp;
    align-items: center;
    gap: 6dp;
}

.screw { display: block; width: 12dp; height: 12dp; }
.vent { display: block; width: 72dp; height: 12dp; }

.notice
{
    display: block;
    height: 20dp;
    line-height: 20dp;
    padding: 0dp 10dp;
    margin: 0dp 4dp;
    border-width: 1dp;
    border-radius: 3dp;
    font-family: "JetBrains Mono";
    font-size: 11dp;
}

.key
{
    display: block;
    min-width: 24dp;
    height: 22dp;
    line-height: 22dp;
    padding: 0dp 7dp;
    text-align: center;
    border-width: 1dp;
    border-radius: 3dp;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 11dp;
    letter-spacing: 1dp;
    pointer-events: auto;
    tab-index: auto;
}

.key:active
{
    /* Pressed in by a physical key's travel. */
    transform: translateY(1dp);
}

.glyph
{
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    font-size: 11dp;
}

.dial
{
    display: flex;
    align-items: center;
    height: 24dp;
    padding: 0dp 10dp 0dp 3dp;
    gap: 7dp;
    border-width: 1dp;
    border-radius: 12dp;
    pointer-events: auto;
    tab-index: auto;
}

.knob
{
    display: block;
    width: 18dp;
    height: 18dp;
    border-width: 1dp;
    border-radius: 9dp;
}

.dial_label
{
    display: block;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 12dp;
    letter-spacing: 1dp;
}

.lamp
{
    display: block;
    width: 8dp;
    height: 8dp;
    border-width: 1dp;
    border-radius: 4dp;
}

.readout
{
    display: flex;
    align-items: center;
    gap: 5dp;
    height: 22dp;
    padding: 0dp 7dp;
    border-width: 1dp;
    border-radius: 3dp;
    font-family: "JetBrains Mono";
    pointer-events: auto;
}

#transport
{
    display: flex;
    align-items: center;
    gap: 4dp;
    height: 26dp;
    padding: 0dp 4dp;
    border-width: 1dp;
    border-radius: 4dp;
    pointer-events: auto;
}

.transport_text
{
    display: block;
    max-width: 220dp;
    overflow: hidden;
    padding: 0dp 4dp;
    font-family: "JetBrains Mono";
    font-size: 11dp;
}

#window_keys
{
    display: flex;
    gap: 3dp;
    margin-left: 6dp;
}

#dismiss
{
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
}

#popover
{
    display: block;
    position: absolute;
    top: 38dp;
    width: 280dp;
    padding: 4dp 0dp;
    border-width: 1dp;
    border-radius: 4dp;
    pointer-events: auto;
}

/* From a bottom instrument, a popover rises over it instead. */
#popover.rising
{
    top: auto;
    bottom: 52dp;
}

.entry
{
    display: flex;
    justify-content: space-between;
    height: 24dp;
    line-height: 24dp;
    padding: 0dp 12dp;
}

.entry.heading
{
    height: 20dp;
    line-height: 20dp;
    margin-top: 4dp;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 10dp;
    letter-spacing: 2dp;
    pointer-events: none;
}

.entry.disabled
{
    pointer-events: none;
}

.entry_icon { width: 16dp; height: 16dp; margin: 4dp 8dp 0dp 0dp; }
.entry_label { display: block; flex: 1; }

.entry_chord
{
    display: block;
    font-family: "JetBrains Mono";
    font-size: 11dp;
}


/* The station and its card, bottom left: the operation in hand and what it
   is set to. */
#instruments_left
{
    display: flex;
    position: absolute;
    left: 8dp;
    bottom: 8dp;
    align-items: flex-end;
    gap: 8dp;
    pointer-events: none;
}

#station_bay
{
    display: flex;
    flex-direction: column;
    width: 260dp;
    gap: 6dp;
    pointer-events: none;
}

#readout
{
    display: flex;
    height: 34dp;
    align-items: center;
    border-width: 1dp;
    border-radius: 4dp;
    font-family: "JetBrains Mono";
    font-size: 12dp;
    pointer-events: auto;
}

.segment
{
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0dp 10dp;
    gap: 6dp;
    border-right-width: 1dp;
}
.segment .lamp { width: 8dp; height: 8dp; border-width: 1dp; border-radius: 4dp; }

#instruments_right
{
    display: flex;
    position: absolute;
    right: 8dp;
    bottom: 8dp;
    gap: 8dp;
    pointer-events: none;
}

#holding
{
    display: flex;
    align-items: center;
    height: 34dp;
    padding: 0dp 4dp;
    gap: 6dp;
    border-width: 1dp;
    border-radius: 4dp;
    pointer-events: auto;
}

.cartridge
{
    display: flex;
    align-items: center;
    height: 100%;
    padding-right: 8dp;
    gap: 8dp;
    border-right-width: 1dp;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 12dp;
    letter-spacing: 1dp;
}

.picture_well
{
    display: block;
    width: 26dp;
    height: 26dp;
    border-width: 1dp;
    border-radius: 2dp;
}
.cartridge_label.empty { text-transform: uppercase; }
.picture { display: block; width: 100%; height: 100%; }

#stash { display: flex; gap: 4dp; }
.stash_slot { width: 20dp; height: 20dp; opacity: 0.55; }
.stash_slot.filled, .stash_slot:hover { opacity: 1; }

#cat_View
{
    display: flex;
    align-items: center;
    height: 34dp;
    padding: 0dp 12dp;
    gap: 10dp;
    border-width: 1dp;
    border-radius: 4dp;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 12dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
    pointer-events: auto;
}

#station
{
    display: flex;
    align-items: center;
    height: 34dp;
    padding: 0dp 12dp;
    gap: 8dp;
    border-width: 1dp;
    border-radius: 4dp;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 12dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
    pointer-events: auto;
}

.station_icon { width: 18dp; height: 18dp; }
.station_variant { font-size: 11dp; }

#tool_card
{
    display: block;
    padding: 8dp 10dp;
    border-width: 1dp;
    border-radius: 4dp;
    pointer-events: auto;
}

.setting
{
    display: flex;
    align-items: center;
    height: 26dp;
    gap: 8dp;
}

.setting_label { display: block; width: 84dp; font-size: 11dp; }
.setting_control { display: block; flex: 1; height: 20dp; }
.setting_number
{
    display: block;
    width: 38dp;
    padding: 0dp 4dp;
    border-width: 1dp;
    text-align: right;
    font-family: "JetBrains Mono";
    font-size: 11dp;
}
.setting_toggle { flex: 0; }

#tool_hint { display: block; margin-top: 6dp; font-size: 11dp; }

#tool_keys
{
    display: flex;
    justify-content: flex-end;
    gap: 6dp;
    margin-top: 8dp;
}

/* A setting's slider and drop-down: geometry here, colours the theme's. */
slidertrack
{
    display: block;
    height: 4dp;
    margin-top: 8dp;
    border-radius: 2dp;
    pointer-events: auto;
}
sliderbar
{
    display: block;
    width: 10dp;
    height: 16dp;
    margin-top: -6dp;
    border-radius: 2dp;
    pointer-events: auto;
}
sliderprogress { display: block; height: 4dp; pointer-events: auto; }
sliderarrowdec, sliderarrowinc { display: none; }

selectvalue { display: block; padding: 2dp 6dp; pointer-events: auto; }
selectarrow { display: block; width: 16dp; height: 100%; pointer-events: auto; }
selectbox { display: block; border-width: 1dp; border-radius: 3dp; pointer-events: auto; }
selectbox option { display: block; padding: 4dp 6dp; pointer-events: auto; }
