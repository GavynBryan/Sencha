<rml>
<head>
    <title>Shell</title>
    <link type="text/rcss" href="controls.rcss"/>
    <link type="text/rcss" href="shell.rcss"/>
    <link type="text/rcss" href="icons.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<body data-model="shell" data-class-moving="motion" data-class-deck="deck" data-class-lanes1="deck_lanes == 1"
      data-class-lanes2="deck_lanes == 2"
      data-class-lanes3="deck_lanes == 3" data-class-lanes4="deck_lanes >= 4">
    <!-- The rail: the window's caption and the one full-width piece of chrome.
         Left is identity (the hatch, which workspace, which document), right is
         consequence (problems, the transport, the window), and the middle is
         where the window is dragged from and where notices pass through. -->
    <div id="rail" class="theme-rail">
        <div id="rail_left">
            <div id="hatch" class="key theme-key" data-class-lit="popover == 'hatch'"
                 data-event-click="shell_popover('hatch')"><span class="glyph">&#xf0c9;</span></div>
            <div id="workspace_dial" class="dial theme-plate" data-class-lit="popover == 'workspaces'"
                 data-event-click="shell_popover('workspaces')">
                <div class="knob theme-key"></div>
                <span class="dial_label">{{workspace_label}}</span>
            </div>
            <div id="document_dial" class="dial theme-plate" data-if="document_label != ''"
                 data-event-click="shell_popover('document')">
                <div class="lamp theme-lamp" data-class-lit="document_changed"></div>
                <span class="dial_label">{{document_label}}</span>
            </div>
        </div>

        <div id="notices">
            <!-- The grille the rail is dragged by, fastened at both ends. -->
            <div id="grille">
                <img class="screw theme-art" src="art/screw.svg"/>
                <img class="vent theme-art" src="art/vent.svg"/>
                <img class="screw theme-art" src="art/screw.svg"/>
            </div>
            <div class="notice theme-readout" data-for="notice : notices"
                 data-class-warning="notice.detail == 'warning'"
                 data-class-failed="notice.detail == 'failed'">{{notice.label}}</div>
        </div>

        <div id="rail_right">
            <div id="problems" class="readout theme-readout" data-if="problem_count > 0"
                 data-class-lit="popover == 'problems'" data-event-click="shell_popover('problems')">
                <div class="lamp theme-lamp" data-class-warn="!problem_errors" data-class-fault="problem_errors"></div>
                <span class="count">{{problem_count}}</span>
            </div>
            <div id="transport" class="theme-plate" data-if="transport_state != 'none'">
                <div class="key theme-key" data-class-disabled="!cook_enabled"
                     data-event-click="shell_invoke('transport.cook')">COOK</div>
                <div class="key theme-key" data-class-lit="transport_state == 'playing'"
                     data-class-disabled="!play_enabled"
                     data-event-click="shell_invoke('transport.play')">PLAY</div>
                <div class="key theme-key" data-class-disabled="!stop_enabled"
                     data-event-click="shell_invoke('transport.stop')">STOP</div>
                <div id="cat_Transport" class="segment theme-segment" data-class-lit="popover == 'category:Transport'"
                     data-event-click="shell_popover('category:Transport')">
                    <div class="lamp theme-lamp" data-class-on="transport_state == 'playing'"
                         data-class-warn="transport_state == 'cooking'"
                         data-class-fault="transport_state == 'failed'"></div>
                    <span class="transport_text theme-dim" data-if="transport_text != ''">{{transport_text}}</span>
                    <span class="glyph theme-dim">&#xf078;</span>
                </div>
            </div>
            <div id="window_keys">
                <div class="key theme-key" data-event-click="shell_window('minimize')"><span class="glyph">&#xf2d1;</span></div>
                <div class="key theme-key" data-event-click="shell_window('maximize')"><span class="glyph">&#xf2d0;</span></div>
                <div class="key theme-key" data-event-click="shell_window('close')"><span class="glyph">&#xf00d;</span></div>
            </div>
        </div>
    </div>

    <!-- Bottom left, what the hands are doing: the station (and over it, while
         the operation has settings or drafted work, its card), then how they
         act -- element, gizmo, grid -- each segment opening its category. -->
    <div id="instruments_left">
    <div id="station_bay" data-if="station_name != ''">
        <div id="tool_card" class="theme-plate" data-class-open="card_open" data-class-shut="!card_open">
            <div class="setting" data-for="row : tool_rows"
                 data-style-margin-left="(row.depth * 8) + 'dp'"
                 data-class-heading="row.control == 'section'" data-class-verb="row.control == 'action'"
                 data-class-locked="!row.editable &amp;&amp; row.control != 'section' &amp;&amp; row.control != 'action'">
                <span class="setting_label" data-if="row.control != 'action'">{{row.label}}</span>
                <input type="text" class="setting_control theme-field" data-if="row.control == 'text' &amp;&amp; row.editable"
                       data-value="row.value"
                       data-event-focus="shell_sheet_hold('tool', it_index)"
                       data-event-blur="shell_sheet_release('tool', it_index)"/>
                <span class="setting_value" data-if="row.control == 'text' &amp;&amp; !row.editable">{{row.value}}</span>
                <input type="range" class="setting_control" data-if="row.control == 'range'"
                       data-attr-min="row.min" data-attr-max="row.max" data-attr-step="row.step"
                       data-value="row.number" data-event-change="shell_sheet_set('tool', it_index, ev.value)"/>
                <span class="setting_number theme-readout" data-if="row.control == 'range'">{{row.value}}</span>
                <select class="setting_control theme-field" data-if="row.control == 'choice'"
                        data-value="row.value" data-event-change="shell_sheet_set('tool', it_index, ev.value)">
                    <option data-for="c : row.choices" data-attr-value="c">{{c}}</option>
                </select>
                <div class="setting_toggle key theme-key" data-if="row.control == 'toggle'"
                     data-class-lit="row.value == 'true'" data-event-click="shell_sheet_flip('tool', it_index)">
                    <span data-if="row.value == 'true'">ON</span><span data-if="row.value != 'true'">OFF</span>
                </div>
                <div class="key theme-key" data-if="row.control == 'action'"
                     data-event-click="shell_sheet_act('tool', it_index, '')">{{row.label}}</div>
                <textarea class="setting_control setting_long theme-field" data-if="row.control == 'longtext'" rows="5"
                          data-value="row.value" data-event-focus="shell_sheet_hold('tool', it_index)"
                          data-event-blur="shell_sheet_release('tool', it_index)"></textarea>
                <textarea class="setting_control setting_long theme-field" data-if="row.control == 'longtext'" rows="5"
                      data-value="row.value" data-event-focus="shell_sheet_hold('selection', it_index)"
                      data-event-blur="shell_sheet_release('selection', it_index)"></textarea>
            <div class="setting_color" data-if="row.control == 'color'">
                    <div class="swatch theme-field" data-style-background-color="row.control == 'color' ? row.parts[0] : 'transparent'"></div>
                    <input type="text" class="setting_control theme-field" data-value="row.value"
                           data-event-focus="shell_sheet_hold('tool', it_index)"
                           data-event-blur="shell_sheet_release('tool', it_index)"/>
                </div>
                <div class="setting_control key theme-key" data-if="row.control == 'asset'"
                     data-class-disabled="!row.editable" data-event-click="shell_sheet_pick('tool', it_index)">
                    <span data-if="row.value != ''">{{row.value}}</span><span data-if="row.value == ''">NONE</span>
                </div>
            </div>
            <div id="tool_hint" class="theme-dim" data-if="station_hint != ''">{{station_hint}}</div>
            <div id="tool_keys" data-if="draft != 'none'">
                <div class="key theme-key" data-class-lit="draft == 'ready'" data-class-disabled="draft != 'ready'"
                     data-event-click="shell_invoke('tool.apply')">APPLY</div>
                <div class="key theme-key" data-event-click="shell_invoke('tool.cancel')">CANCEL</div>
            </div>
        </div>
        <div id="station" class="theme-plate" data-class-lit="popover == 'tools'"
             data-event-click="shell_popover('tools')">
            <span data-if="station_icon != ''" data-attr-class="'station_icon icon icon-' + station_icon"></span>
            <span class="station_name">{{station_name}}</span>
            <span class="station_variant theme-accent" data-if="station_variant != ''">{{station_variant}}</span>
        </div>
    </div>
    <div id="readout" class="theme-readout" data-if="element != ''">
        <div id="cat_Mode" class="segment theme-segment" data-class-lit="popover == 'category:Mode'"
             data-event-click="shell_popover('category:Mode')"><span>{{element}}</span></div>
        <div id="cat_Transform" class="segment theme-segment" data-class-lit="popover == 'category:Transform'"
             data-event-click="shell_popover('category:Transform')">
            <span>{{gizmo_mode}}</span><span class="theme-dim">&#183;</span><span>{{gizmo_space}}</span>
            <span class="theme-warning" data-if="pivot">PIVOT</span>
        </div>
        <div id="cat_Grid" class="segment theme-segment" data-class-lit="popover == 'category:Grid'"
             data-event-click="shell_popover('category:Grid')">
            <div class="lamp theme-lamp" data-class-on="snap"></div><span>{{grid}}u</span>
        </div>
    </div>
    </div>

    <!-- What is selected: its name, its settings, and what can be done to
         it now -- or, while an edit is previewed, applying or cancelling it.
         Looked at closely it becomes the drawer along the right edge, with
         every property it has. -->
    <div id="selection_card" class="theme-plate" data-class-open="selection_title != ''"
         data-class-shut="selection_title == ''" data-class-drawer="drawer" data-class-sheet="sheet">
        <div id="selection_head">
            <span id="selection_title" class="theme-accent">{{selection_title}}</span>
            <div class="key theme-key" data-if="!sheet" data-class-lit="drawer" data-event-click="shell_drawer('toggle')">
                <span data-if="!drawer">DETAILS</span><span data-if="drawer">CLOSE</span>
            </div>
        </div>
        <div id="selection_chips" data-if="!drawer &amp;&amp; !sheet">
            <div class="key theme-key" data-for="chip : selection_chips"
                 data-event-click="shell_drawer(chip.key)">{{chip.label}}</div>
        </div>
        <div id="drawer_chips" data-if="drawer">
            <div class="key theme-key" data-class-lit="drawer_focus == ''" data-event-click="shell_drawer('')">ALL</div>
            <div class="key theme-key" data-for="chip : selection_chips" data-class-lit="chip.selected"
                 data-event-click="shell_drawer(chip.key)">{{chip.label}}</div>
        </div>
        <div class="setting" data-for="row : selection_rows"
             data-style-margin-left="(row.depth * 8) + 'dp'"
             data-class-heading="row.control == 'section'" data-class-verb="row.control == 'action'"
             data-class-locked="!row.editable &amp;&amp; row.control != 'section' &amp;&amp; row.control != 'action'">
            <span class="setting_label" data-if="row.control != 'action'">{{row.label}}</span>
            <input type="text" class="setting_control theme-field" data-if="row.control == 'text' &amp;&amp; row.editable"
                   data-value="row.value"
                   data-event-focus="shell_sheet_hold('selection', it_index)"
                   data-event-blur="shell_sheet_release('selection', it_index)"/>
            <span class="setting_value" data-if="row.control == 'text' &amp;&amp; !row.editable">{{row.value}}</span>
            <input type="range" class="setting_control" data-if="row.control == 'range'"
                   data-attr-min="row.min" data-attr-max="row.max" data-attr-step="row.step"
                   data-value="row.number" data-event-change="shell_sheet_set('selection', it_index, ev.value)"/>
            <span class="setting_number theme-readout" data-if="row.control == 'range'">{{row.value}}</span>
            <select class="setting_control theme-field" data-if="row.control == 'choice'"
                    data-value="row.value" data-event-change="shell_sheet_set('selection', it_index, ev.value)">
                <option data-for="c : row.choices" data-attr-value="c">{{c}}</option>
            </select>
            <div class="setting_toggle key theme-key" data-if="row.control == 'toggle'"
                 data-class-lit="row.value == 'true'" data-event-click="shell_sheet_flip('selection', it_index)">
                <span data-if="row.value == 'true'">ON</span><span data-if="row.value != 'true'">OFF</span>
            </div>
            <div class="key theme-key" data-if="row.control == 'action'"
                 data-event-click="shell_sheet_act('selection', it_index, '')">{{row.label}}</div>
            <div class="setting_color" data-if="row.control == 'color'">
                <div class="swatch theme-field" data-style-background-color="row.control == 'color' ? row.parts[0] : 'transparent'"></div>
                <input type="text" class="setting_control theme-field" data-value="row.value"
                       data-event-focus="shell_sheet_hold('selection', it_index)"
                       data-event-blur="shell_sheet_release('selection', it_index)"/>
            </div>
            <div class="setting_control key theme-key" data-if="row.control == 'asset'"
                 data-class-disabled="!row.editable" data-event-click="shell_sheet_pick('selection', it_index)">
                <span data-if="row.value != ''">{{row.value}}</span><span data-if="row.value == ''">NONE</span>
            </div>
            <span class="setting_help theme-dim" data-if="sheet &amp;&amp; row.detail != ''">{{row.detail}}</span>
        </div>
        <div id="selection_verbs">
            <div class="key theme-key" data-for="verb : selection_verbs"
                 data-class-disabled="verb.disabled" data-class-lit="selection_staged &amp;&amp; it_index == 0"
                 data-event-click="shell_invoke(verb.key)">{{verb.label}}</div>
        </div>
    </div>
    <!-- An explorer: what the workspace lets a person browse, a page at a
         time. Pictures are a tray over the bottom of the content; an outline
         is a sheet down its left side. A click picks an item up, a double
         click puts it to use. -->
    <div id="explorer" class="theme-plate" data-if="explorer_id != ''"
         data-class-outline="explorer_shape == 'outline'">
        <div id="explorer_head">
            <span id="explorer_title" class="theme-accent">{{explorer_title}}</span>
            <input type="text" id="explorer_filter" class="theme-field"
                   data-event-change="shell_explorer_filter(ev.value)"/>
            <span id="explorer_range" class="theme-dim">{{explorer_range}}</span>
            <div class="key theme-key" data-if="explorer_earlier || explorer_later" data-class-disabled="!explorer_earlier"
                 data-event-click="shell_explorer_page(-1)"><span class="glyph">&#xf053;</span></div>
            <div class="key theme-key" data-if="explorer_earlier || explorer_later" data-class-disabled="!explorer_later"
                 data-event-click="shell_explorer_page(1)"><span class="glyph">&#xf054;</span></div>
            <div class="key theme-key" data-for="verb : explorer_verbs" data-class-disabled="verb.disabled"
                 data-event-click="shell_invoke(verb.key)">{{verb.label}}</div>
            <div class="key theme-key" data-event-click="shell_explorer_close()"><span class="glyph">&#xf00d;</span></div>
        </div>
        <div id="explorer_items">
            <div class="explorer_item theme-row" data-for="item : explorer_items" data-class-selected="item.selected"
                 data-style-padding-left="(item.depth * 12 + 6) + 'dp'"
                 data-event-click="shell_explorer_pick(item.key, ev.shift_key, ev.ctrl_key)"
                 data-event-dblclick="shell_explorer_commit(item.key)">
                <div class="picture_well theme-field" data-if="explorer_shape == 'pictures'">
                    <img class="picture" data-if="item.value != ''" data-attr-src="'host:' + item.value"/>
                </div>
                <span class="branch glyph theme-dim" data-if="explorer_shape == 'outline'"
                      data-event-click="shell_explorer_open(item.key)">
                    <span data-if="item.value == 'closed'">&#xf0da;</span><span data-if="item.value == 'open'">&#xf0d7;</span>
                </span>
                <span class="item_label">{{item.label}}</span>
                <div class="marks" data-if="explorer_shape == 'outline'">
                    <span data-for="mark : item.parts" data-attr-class="'mark icon icon-' + mark"
                          data-event-click="shell_explorer_mark(item.key, it_index)"></span>
                </div>
            </div>
            <div id="explorer_empty" class="theme-dim" data-if="explorer_empty != ''">{{explorer_empty}}</div>
        </div>
    </div>

    <!-- Bottom right, what the hands hold: the cartridge the next operation
         consumes, which opens what can be done with it, and the stash beside
         it, where a click trades a slot with the cartridge. -->
    <div id="instruments_right">
        <div id="instrument_row">
        <div id="holding" class="theme-plate" data-if="holding_role != ''">
            <div id="cat_Resource" class="cartridge theme-segment" data-class-lit="explorer_id == holding_explorer"
                 data-event-click="shell_explore(holding_explorer)">
                <div class="picture_well theme-field">
                    <img class="picture" data-if="holding_image != ''" data-attr-src="'host:' + holding_image"/>
                </div>
                <span class="cartridge_label" data-if="holding_label != ''">{{holding_label}}</span>
                <span class="cartridge_label empty theme-dim" data-if="holding_label == ''">No {{holding_role}}</span>
            </div>
            <div class="key theme-key" data-class-lit="popover == 'category:Resource'"
                 data-event-click="shell_popover('category:Resource')"><span class="glyph">&#xf078;</span></div>
            <div id="stash">
                <div class="picture_well stash_slot theme-field" data-for="slot : stash"
                     data-class-filled="slot.label != ''" data-event-click="shell_invoke(slot.key)">
                    <img class="picture" data-if="slot.value != ''" data-attr-src="'host:' + slot.value"/>
                </div>
            </div>
        </div>
        </div>
    </div>

    <!-- Top right of the content, how the work is seen: which view, and how
         many share the content. -->
    <div id="cat_View" class="theme-plate" data-if="projection != ''"
         data-class-lit="popover == 'category:View'" data-event-click="shell_popover('category:View')">
        <span class="view_projection">{{projection}}</span>
        <span class="view_count theme-accent" data-if="view_count > 0">{{view_count}}&#9635;</span>
    </div>

    <!-- A popover: one decision, anchored under the instrument that opened it.
         Anything outside it takes it away, which is what the catch is for. -->
    <div id="dismiss" data-if="popover != ''" data-event-click="shell_popover('')"></div>
    <div id="popover" class="theme-surface" data-if="popover != ''" data-class-rising="popover_rises"
         data-class-problems="popover == 'problems'"
         data-style-left="popover_x + 'px'" data-style-top="popover_top">
        <div class="entry theme-row" data-for="entry : entries"
             data-class-heading="entry.control == 'section'"
             data-class-disabled="entry.disabled"
             data-class-selected="entry.selected"
             data-event-click="shell_choose(entry.key)">
            <span data-if="entry.icon != ''" data-attr-class="'entry_icon icon icon-' + entry.icon"></span>
            <span class="entry_label">{{entry.label}}</span>
            <span class="entry_chord theme-muted">{{entry.value}}</span>
        </div>
    </div>
</body>
</rml>
