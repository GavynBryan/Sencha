/* A workspace's rendered content: display only, placed in window pixels by
   the host. What falls outside the content is cut off at its edge. */

body
{
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

#content { display: block; position: absolute; overflow: hidden; }
#picture { display: block; position: absolute; }

.frame { display: block; position: absolute; border-width: 1dp; }
.frame.active { border-width: 2dp; }
.frame.faint { opacity: 0.45; }
