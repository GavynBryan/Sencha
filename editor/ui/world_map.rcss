@font-face { src: "fonts/Inter-Regular.ttf"; }
@font-face { src: "fonts/ChakraPetch-SemiBold.ttf"; }
@font-face { src: "fonts/fa-solid-900.ttf"; }

body
{
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    font-family: Inter;
    font-size: 11dp;
}

#ground, .zone, .link, .arrow, #camera
{
    display: block;
    position: absolute;
}

#map_head
{
    display: flex;
    position: absolute;
    left: 16dp;
    bottom: 64dp;
    align-items: baseline;
    gap: 12dp;
}
#map_title
{
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 14dp;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.zone
{
    box-sizing: border-box;
    padding: 4dp 6dp;
    border-width: 1dp;
    border-radius: 3dp;
    overflow: hidden;
}
.zone.focus, .zone.hot, .zone.problem { border-width: 2dp; }
.zone_name { display: block; white-space: nowrap; font-weight: 600; }
.zone_state, .zone_here { display: block; white-space: nowrap; font-size: 10dp; }

/* A way between zones: a bar from one centre, turned to the other. */
.link
{
    height: 2dp;
    margin-top: -1dp;
    transform-origin: 0% 50%;
}
.arrow
{
    width: 0dp;
    height: 0dp;
}
.arrow .glyph
{
    display: block;
    position: absolute;
    left: -6dp;
    top: -9dp;
    width: 12dp;
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    font-size: 16dp;
    text-align: center;
}

#camera
{
    width: 10dp;
    height: 10dp;
    margin-left: -5dp;
    margin-top: -5dp;
    border-radius: 5dp;
}
