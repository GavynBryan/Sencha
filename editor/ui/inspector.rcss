@font-face
{
    src: "fonts/Inter-Regular.ttf";
}

/* The selected entity's schema as a document. Structure only -- every colour
   comes from theme.rcss, which the host generates from the active editor theme
   and replaces at runtime. A rule here that painted something would be a colour
   that could not follow a theme switch.

   Lengths are dp, not px. The surface carries the display scale the editor
   resolved, and RmlUi applies it to dp alone -- a document authored in px is a
   document that ignores the setting and renders half-size beside chrome that
   did not. At scale 1 the two are the same number. */

body
{
    display: block;
    width: 100%;
    height: 100%;
    /* Covers the window so the panel can anchor against it. Only the panel
       itself counts as the pointer being over the UI. */
    pointer-events: none;
    font-family: Inter;
    font-size: 13dp;
}

/* Anchored to the right edge over the ImGui shell it coexists with, and
   deliberately not docked: an authored surface that had to participate in the
   dock layout would need a render target to draw into, which is separate work. */
#panel
{
    display: block;
    position: absolute;
    right: 0;
    top: 0;
    width: 340dp;
    height: 100%;
    border-left-width: 1dp;
    pointer-events: auto;
}

#titlebar
{
    display: block;
    width: 100%;
    height: 30dp;
}

#title
{
    display: inline-block;
    margin-left: 10dp;
    line-height: 30dp;
}

#close
{
    display: block;
    position: absolute;
    right: 0;
    top: 0;
    width: 30dp;
    height: 30dp;
    text-align: center;
    line-height: 30dp;
}

/* The scroll surface. A real entity carries more fields than fit, so this is
   also where the clip path earns itself on a surface somebody uses. */
#fields
{
    display: block;
    position: absolute;
    left: 0;
    top: 30dp;
    bottom: 26dp;
    width: 100%;
    overflow-y: auto;
}

/* Three columns, placed rather than flowed. Inline boxes would inherit the
   whitespace between the markup elements and the widths would stop adding up,
   which is how a 340dp panel ends up 12dp wider than itself. */
.field
{
    display: block;
    position: relative;
    width: 100%;
    height: 24dp;
}

.name
{
    display: block;
    position: absolute;
    left: 8dp;
    top: 0dp;
    width: 106dp;
    height: 24dp;
    line-height: 24dp;
    overflow: hidden;
}

.value
{
    box-sizing: border-box;
    display: block;
    position: absolute;
    left: 118dp;
    top: 3dp;
    width: 128dp;
    height: 18dp;
    padding: 0dp 4dp;
    /* Width here, colour in the theme: the shorthand would set both, and a
       document that set a border colour would not follow a theme switch. */
    border-width: 1dp;
    border-radius: 2dp;
}

/* A field the host will not take text for: an identity, an asset handle, a leaf
   the schema cannot express. Shown, because an entity that quietly carries more
   than the panel admits to is the surprise -- just not offered a box that would
   snap back. */
/* A value nobody types into does not have to line up with the boxes that are
   typed into, and an asset path needs every pixel it can get. */
.value.fixed
{
    top: 0dp;
    width: 136dp;
    height: 24dp;
    line-height: 24dp;
    padding: 0dp 5dp;
    border-width: 0dp;
    overflow: hidden;
}

.origin
{
    display: block;
    position: absolute;
    right: 8dp;
    top: 0dp;
    width: 78dp;
    height: 24dp;
    line-height: 24dp;
    text-align: right;
    font-size: 11dp;
    overflow: hidden;
}

#empty
{
    display: block;
    padding: 12dp 10dp;
}

#status
{
    display: block;
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 26dp;
    padding: 0dp 10dp;
    line-height: 26dp;
}

scrollbarvertical
{
    width: 8dp;
}

scrollbarvertical sliderbar
{
    width: 8dp;
    border-radius: 4dp;
}

/* The asset picker. Anchored inside the panel, because it is choosing a value
   for one field rather than interrupting the editor. */
#picker
{
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

#picker_scrim
{
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

#picker_panel
{
    display: block;
    position: absolute;
    left: 16dp;
    top: 60dp;
    width: 308dp;
    height: 320dp;
    border-width: 1dp;
    border-radius: 3dp;
}

#picker_title
{
    display: block;
    width: 100%;
    height: 26dp;
    padding: 0dp 10dp;
    line-height: 26dp;
}

#picker_list
{
    display: block;
    position: absolute;
    left: 6dp;
    top: 32dp;
    width: 296dp;
    height: 282dp;
    border-width: 1dp;
    overflow-y: auto;
}

.option
{
    display: block;
    width: 100%;
    height: 22dp;
    padding: 0dp 8dp;
    line-height: 22dp;
    overflow: hidden;
}
