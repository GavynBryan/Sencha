@font-face
{
    src: "fonts/Inter-Regular.ttf";
}

/* The selected entity's schema as a document. Structure only -- every colour
   comes from theme.rcss, which the host generates from the active editor theme
   and replaces at runtime. A rule here that painted something would be a colour
   that could not follow a theme switch. */

body
{
    display: block;
    width: 100%;
    height: 100%;
    /* Covers the window so the panel can anchor against it. Only the panel
       itself counts as the pointer being over the UI. */
    pointer-events: none;
    font-family: Inter;
    font-size: 13px;
}

/* Anchored to the right edge over the ImGui shell it coexists with, and
   deliberately not docked: an authored surface that had to participate in the
   dock layout would need a render target to draw into, which is separate work. */
#panel
{
    display: block;
    position: absolute;
    right: 0;
    top: 0;
    width: 340px;
    height: 100%;
    border-left-width: 1px;
    pointer-events: auto;
}

#titlebar
{
    display: block;
    width: 100%;
    height: 30px;
}

#title
{
    display: inline-block;
    margin-left: 10px;
    line-height: 30px;
}

#close
{
    display: block;
    position: absolute;
    right: 0;
    top: 0;
    width: 30px;
    height: 30px;
    text-align: center;
    line-height: 30px;
}

/* The scroll surface. A real entity carries more fields than fit, so this is
   also where the clip path earns itself on a surface somebody uses. */
#fields
{
    display: block;
    position: absolute;
    left: 0;
    top: 30px;
    bottom: 26px;
    width: 100%;
    overflow-y: auto;
}

/* Three columns, placed rather than flowed. Inline boxes would inherit the
   whitespace between the markup elements and the widths would stop adding up,
   which is how a 340px panel ends up 12px wider than itself. */
.field
{
    display: block;
    position: relative;
    width: 100%;
    height: 24px;
}

.name
{
    display: block;
    position: absolute;
    left: 8px;
    top: 0px;
    width: 106px;
    height: 24px;
    line-height: 24px;
    overflow: hidden;
}

.value
{
    box-sizing: border-box;
    display: block;
    position: absolute;
    left: 118px;
    top: 3px;
    width: 128px;
    height: 18px;
    padding: 0px 4px;
    /* Width here, colour in the theme: the shorthand would set both, and a
       document that set a border colour would not follow a theme switch. */
    border-width: 1px;
    border-radius: 2px;
}

/* A field the host will not take text for: an identity, an asset handle, a leaf
   the schema cannot express. Shown, because an entity that quietly carries more
   than the panel admits to is the surprise -- just not offered a box that would
   snap back. */
.value.fixed
{
    top: 0px;
    height: 24px;
    line-height: 24px;
    padding: 0px 5px;
    border-width: 0px;
    overflow: hidden;
}

.origin
{
    display: block;
    position: absolute;
    right: 8px;
    top: 0px;
    width: 78px;
    height: 24px;
    line-height: 24px;
    text-align: right;
    font-size: 11px;
    overflow: hidden;
}

#empty
{
    display: block;
    padding: 12px 10px;
}

#status
{
    display: block;
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 26px;
    padding: 0px 10px;
    line-height: 26px;
}

scrollbarvertical
{
    width: 8px;
}

scrollbarvertical sliderbar
{
    width: 8px;
    border-radius: 4px;
}
