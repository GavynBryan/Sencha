@font-face { src: "fonts/Inter-Regular.ttf"; }
@font-face { src: "fonts/ChakraPetch-SemiBold.ttf"; }

/* A radial menu: geometry only, placed in window pixels by the host; colours
   are theme roles. Nothing here takes the pointer -- the session does. */

body
{
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    font-family: Inter;
    font-size: 11dp;
}

sector, .caption
{
    display: block;
    position: absolute;
}

/* The hot petal and a glyph's well are outlined, inside the shape's edge. */
sector.theme-wheel-hot { stroke-width: 2dp; }
sector.well { stroke-width: 1dp; text-align: center; }
.well.variant { font-size: 10dp; }
.well .icon { width: 70%; height: 70%; margin-top: 15%; }
.well .initial
{
    display: block;
    margin-top: 22%;
    white-space: nowrap;
    overflow: hidden;
    font-family: "Chakra Petch";
    font-weight: 600;
    text-transform: uppercase;
}

.caption { text-align: center; }
.ledge
{
    padding: 2dp 10dp;
    border-width: 1dp;
    border-radius: 3dp;
    white-space: nowrap;
    font-family: "Chakra Petch";
    font-weight: 600;
    letter-spacing: 1dp;
    text-transform: uppercase;
}
.ledge.dim { opacity: 0.6; }

/* An entry with no glyph is its word, across its petal. */
.word
{
    display: flex;
    position: absolute;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 11dp;
    letter-spacing: 0.5dp;
    text-transform: uppercase;
}
.word.variant { font-size: 10dp; }
.word { flex-direction: column; gap: 2dp; }
.word .swatch { display: block; width: 26dp; height: 26dp; border-radius: 3dp; }

/* What the wheel is about, read out in the hub. */
.readout
{
    display: flex;
    position: absolute;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}
.readout_line
{
    display: block;
    width: 100%;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    font-family: Inter;
    font-size: 10dp;
    line-height: 13dp;
}
.readout_line.first
{
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 11dp;
}
