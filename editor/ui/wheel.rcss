@font-face { src: "fonts/Inter-Regular.ttf"; }
@font-face { src: "fonts/ChakraPetch-SemiBold.ttf"; }

/* A radial menu: geometry only, placed in window pixels by the host; colours
   are theme roles. Nothing here takes the pointer -- the session does. */

body
{
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    font-family: Inter;
    font-size: 11dp;
}

.plate, .hub, .caption, .key
{
    display: block;
    position: absolute;
}

.plate { border-width: 2dp; }
.hub { border-width: 1dp; }

.key
{
    border-width: 1dp;
    text-align: center;
}
.key.active { border-width: 2dp; }
.key.variant { font-size: 10dp; }
.key .icon { width: 60%; height: 60%; margin-top: 20%; }
.key .initial
{
    display: block;
    margin-top: 30%;
    white-space: nowrap;
    overflow: hidden;
    font-family: "Chakra Petch";
    font-weight: 600;
    text-transform: uppercase;
}

.caption { text-align: center; }
.ledge
{
    padding: 2dp 10dp;
    border-width: 1dp;
    border-radius: 3dp;
    white-space: nowrap;
    font-family: "Chakra Petch";
    font-weight: 600;
    letter-spacing: 1dp;
    text-transform: uppercase;
}
.ledge.dim { opacity: 0.6; }
