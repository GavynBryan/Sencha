<rml>
<head>
    <title>Cook Profiles</title>
    <link type="text/rcss" href="cook_profiles.rcss"/>
</head>
<body data-model="cook_profiles">
    <div id="scrim"/>

    <div id="dialog">
        <div id="titlebar">
            <span id="title">COOK PROFILES</span>
            <div id="close" data-event-click="profiles_close">x</div>
        </div>

        <div id="body">
            <div id="list">
                <div class="row" data-for="profile : profiles"
                     data-event-click="profiles_select(it_index)"
                     data-class-selected="it_index == selected_index">{{profile}}</div>
            </div>

            <div id="form">
                <div class="label">Name</div>
                <input id="name" type="text" data-value="selected_name"/>

                <div class="label">Steps</div>
                <div id="steps">
                    <div class="step" data-for="step : steps">{{step}}</div>
                </div>

                <div class="label" data-if="builtin">Built-in profiles cannot be edited.</div>
            </div>
        </div>

        <div id="footer">
            <div id="status">{{status}}</div>
            <div class="button" data-event-click="profiles_validate">Validate</div>
            <div class="button" data-event-click="profiles_save"
                 data-class-disabled="!dirty">Save</div>
        </div>
    </div>
</body>
</rml>
