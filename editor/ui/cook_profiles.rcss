@font-face
{
    src: "fonts/Inter-Regular.ttf";
}

/* Kyusu's first authored surface. Structure only -- every colour comes from
   theme.rcss, which the host generates from the active editor theme and
   replaces at runtime, so this dialog follows a theme switch without knowing
   one happened. */

body
{
    display: block;
    width: 100%;
    height: 100%;
    /* The document covers the window, so it must not count as the pointer
       being over the UI. The dialog and its controls opt back in. */
    pointer-events: none;
    font-family: Inter;
    font-size: 14px;
}

/* Dims the editor behind, and swallows clicks aimed past the dialog -- which is
   what makes it modal to the pointer as well as to focus. */
#scrim
{
    display: block;
    position: absolute;
    left: 0; top: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
}

#dialog
{
    display: block;
    position: absolute;
    left: 280px;
    top: 140px;
    width: 720px;
    height: 460px;
    border-width: 1px;
    border-radius: 4px;
    pointer-events: auto;
}

#titlebar
{
    display: block;
    width: 100%;
    height: 34px;
}

#title
{
    display: inline-block;
    margin-left: 14px;
    margin-top: 8px;
    font-size: 13px;
}

#close
{
    display: block;
    position: absolute;
    right: 8px;
    top: 6px;
    width: 22px;
    height: 22px;
    text-align: center;
    tab-index: auto;
}

#body
{
    display: block;
    position: absolute;
    left: 0;
    top: 34px;
    width: 720px;
    height: 372px;
}

#list
{
    display: block;
    position: absolute;
    left: 12px;
    top: 12px;
    width: 240px;
    height: 348px;
    border-width: 1px;
    overflow-y: auto;
}

.row
{
    display: block;
    width: 100%;
    height: 26px;
    padding-left: 10px;
    padding-top: 5px;
    tab-index: auto;
}

#form
{
    display: block;
    position: absolute;
    left: 268px;
    top: 12px;
    width: 440px;
    height: 348px;
}

.label
{
    display: block;
    margin-top: 10px;
    margin-bottom: 4px;
    font-size: 12px;
}

#name
{
    display: block;
    width: 420px;
    height: 26px;
    padding-left: 8px;
    border-width: 1px;
    tab-index: auto;
}

#steps
{
    display: block;
    width: 420px;
    height: 200px;
    border-width: 1px;
    overflow-y: auto;
}

.step
{
    display: block;
    height: 22px;
    padding-left: 10px;
    padding-top: 3px;
    font-size: 12px;
}

#footer
{
    display: block;
    position: absolute;
    left: 0;
    top: 406px;
    width: 720px;
    height: 54px;
}

#status
{
    display: block;
    position: absolute;
    left: 14px;
    top: 18px;
    width: 420px;
    font-size: 12px;
}

.button
{
    display: block;
    position: absolute;
    top: 13px;
    width: 96px;
    height: 28px;
    padding-top: 6px;
    text-align: center;
    border-width: 1px;
    border-radius: 3px;
    tab-index: auto;
}

/* The one on the right is Save. */
.button + .button { right: 14px; }
.button { right: 122px; }
