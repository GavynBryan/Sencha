@font-face { src: "fonts/Inter-Regular.ttf"; }

/* The project's cook profiles, as a bench over the editor: the list on the
   left, the selected profile's settings on the right. Geometry only; colours
   are the theme's roles. The document covers the window without counting as
   the pointer being over the UI; the scrim and the dialog opt back in. */

body
{
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    font-family: Inter;
    font-size: 12dp;
}

/* Dims the editor behind, and takes the dialog away when clicked. */
#scrim
{
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
}

#dialog
{
    display: flex;
    flex-direction: column;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 640dp;
    height: 500dp;
    margin-left: -320dp;
    margin-top: -250dp;
    border-width: 1dp;
    border-radius: 4dp;
    pointer-events: auto;
}

#titlebar
{
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 34dp;
    padding: 0dp 8dp 0dp 14dp;
}

#title
{
    display: block;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 12dp;
    letter-spacing: 1dp;
}

#body
{
    display: flex;
    flex: 1;
    gap: 12dp;
    padding: 0dp 12dp;
}

#list
{
    display: block;
    width: 200dp;
    border-width: 1dp;
    border-radius: 3dp;
    overflow-y: auto;
}

.row
{
    display: block;
    height: 26dp;
    line-height: 26dp;
    padding-left: 10dp;
    tab-index: auto;
}

/* Not a scroll container: a flex item that scrolls lays its children out at
   no width. Every setting a profile has fits. */
#form
{
    display: block;
    width: 404dp;
}

.setting_label { width: 130dp; }

#builtin { display: block; margin-top: 10dp; font-size: 11dp; }

#footer
{
    display: flex;
    align-items: center;
    height: 46dp;
    padding: 0dp 12dp;
    gap: 6dp;
}

#status
{
    display: block;
    flex: 1;
    font-size: 11dp;
}
