@font-face
{
    src: "fonts/Inter-Regular.ttf";
}

/* Kyusu's first authored surface. Structure only -- every colour comes from
   theme.rcss, which the host generates from the active editor theme and
   replaces at runtime, so this dialog follows a theme switch without knowing
   one happened.

   Lengths are dp, not px: the surface carries the editor's display scale and
   RmlUi applies it to dp alone. At scale 1 the two are the same number. */

body
{
    display: block;
    width: 100%;
    height: 100%;
    /* The document covers the window, so it must not count as the pointer
       being over the UI. The dialog and its controls opt back in. */
    pointer-events: none;
    font-family: Inter;
    font-size: 14dp;
}

/* Dims the editor behind, and swallows clicks aimed past the dialog -- which is
   what makes it modal to the pointer as well as to focus. */
#scrim
{
    display: block;
    position: absolute;
    left: 0; top: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
}

#dialog
{
    display: block;
    position: absolute;
    left: 280dp;
    top: 140dp;
    width: 720dp;
    height: 460dp;
    border-width: 1dp;
    border-radius: 4dp;
    pointer-events: auto;
}

#titlebar
{
    display: block;
    width: 100%;
    height: 34dp;
}

#title
{
    display: inline-block;
    margin-left: 14dp;
    margin-top: 8dp;
    font-size: 13dp;
}

#close
{
    display: block;
    position: absolute;
    right: 8dp;
    top: 6dp;
    width: 22dp;
    height: 22dp;
    text-align: center;
    tab-index: auto;
}

#body
{
    display: block;
    position: absolute;
    left: 0;
    top: 34dp;
    width: 720dp;
    height: 372dp;
}

#list
{
    display: block;
    position: absolute;
    left: 12dp;
    top: 12dp;
    width: 240dp;
    height: 348dp;
    border-width: 1dp;
    overflow-y: auto;
}

.row
{
    display: block;
    width: 100%;
    height: 26dp;
    padding-left: 10dp;
    padding-top: 5dp;
    tab-index: auto;
}

#form
{
    display: block;
    position: absolute;
    left: 268dp;
    top: 12dp;
    width: 440dp;
    height: 348dp;
}

.label
{
    display: block;
    margin-top: 10dp;
    margin-bottom: 4dp;
    font-size: 12dp;
}

#name
{
    display: block;
    width: 420dp;
    height: 26dp;
    padding-left: 8dp;
    border-width: 1dp;
    tab-index: auto;
}

#steps
{
    display: block;
    width: 420dp;
    height: 200dp;
    border-width: 1dp;
    overflow-y: auto;
}

.step
{
    display: block;
    height: 22dp;
    padding-left: 10dp;
    padding-top: 3dp;
    font-size: 12dp;
}

#footer
{
    display: block;
    position: absolute;
    left: 0;
    top: 406dp;
    width: 720dp;
    height: 54dp;
}

#status
{
    display: block;
    position: absolute;
    left: 14dp;
    top: 18dp;
    width: 420dp;
    font-size: 12dp;
}

.button
{
    display: block;
    position: absolute;
    top: 13dp;
    width: 96dp;
    height: 28dp;
    padding-top: 6dp;
    text-align: center;
    border-width: 1dp;
    border-radius: 3dp;
    tab-index: auto;
}

/* The one on the right is Save. */
.button + .button { right: 14dp; }
.button { right: 122dp; }
