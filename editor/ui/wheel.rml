<rml>
<head>
    <title>Wheel</title>
    <link type="text/rcss" href="wheel.rcss"/>
    <link type="text/rcss" href="icons.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<body data-model="wheel">
    <!-- A radial menu, while its key is held: a plate with petals set into
         it, glyphs where the session hit-tests. Positions are window pixels. -->
    <div id="wheel" data-if="open">
        <!-- Back to front. parts: left, top and diameter of the outer circle,
             start and sweep in degrees, the inner radius as a fraction. -->
        <div class="sector_slot" data-for="s : sectors">
            <sector data-attr-class="'theme-wheel-' + s.detail"
                    data-style-left="s.parts[0]" data-style-top="s.parts[1]"
                    data-style-width="s.parts[2]" data-style-height="s.parts[2]"
                    data-attr-start="s.parts[3]" data-attr-sweep="s.parts[4]" data-attr-inner="s.parts[5]"></sector>
        </div>
        <div class="caption" data-style-left="caption_left" data-style-top="caption_top"
             data-style-width="caption_width" data-style-height="caption_height">
            <span class="ledge theme-readout" data-class-dim="caption_dim">{{caption}}</span>
        </div>
        <sector class="well theme-wheel-well" data-for="key : keys" data-if="key.value != 'none'"
                data-class-lit="key.selected" data-class-active="key.value == 'active'"
                data-class-variant="key.detail == 'variant'"
                data-style-left="key.parts[0]" data-style-top="key.parts[1]"
                data-style-width="key.parts[2]" data-style-height="key.parts[2]">
            <span data-if="key.icon != ''" data-attr-class="'icon icon-' + key.icon"></span>
            <span class="initial" data-if="key.icon == ''">{{key.label}}</span>
        </sector>
    </div>
</body>
</rml>
