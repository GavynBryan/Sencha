<rml>
<head>
    <title>Wheel</title>
    <link type="text/rcss" href="wheel.rcss"/>
    <link type="text/rcss" href="icons.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<body data-model="wheel">
    <!-- A radial menu, while its key is held: a rotary selector whose keys sit
         where the session hit-tests them. Positions are window pixels. -->
    <div id="wheel" data-if="open">
        <div class="disc_slot" data-for="disc : discs">
            <div class="plate theme-plate" data-if="disc.detail == 'plate'"
                 data-style-left="disc.parts[0]" data-style-top="disc.parts[1]"
                 data-style-width="disc.parts[2]" data-style-height="disc.parts[2]"
                 data-style-border-radius="disc.parts[3]"></div>
            <div class="hub theme-readout" data-if="disc.detail == 'hub'"
                 data-style-left="disc.parts[0]" data-style-top="disc.parts[1]"
                 data-style-width="disc.parts[2]" data-style-height="disc.parts[2]"
                 data-style-border-radius="disc.parts[3]"></div>
            <div class="caption" data-if="disc.detail == 'caption'"
                 data-style-left="disc.parts[0]" data-style-top="disc.parts[1]"
                 data-style-width="disc.parts[2]" data-style-height="disc.parts[3]">
                <span class="ledge theme-readout" data-class-dim="caption_dim">{{caption}}</span>
            </div>
        </div>
        <div class="key theme-key" data-for="key : keys"
             data-class-lit="key.selected" data-class-active="key.value == 'active'"
             data-class-variant="key.detail == 'variant'"
             data-style-left="key.parts[0]" data-style-top="key.parts[1]"
             data-style-width="key.parts[2]" data-style-height="key.parts[2]"
             data-style-border-radius="key.parts[3]">
            <span data-if="key.icon != ''" data-attr-class="'icon icon-' + key.icon"></span>
            <span class="initial" data-if="key.icon == ''">{{key.label}}</span>
        </div>
    </div>
</body>
</rml>
