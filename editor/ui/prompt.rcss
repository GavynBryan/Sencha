@font-face { src: "fonts/Inter-Regular.ttf"; }
@font-face { src: "fonts/ChakraPetch-SemiBold.ttf"; }

/* A question that holds an operation: over everything, in the middle of the
   window, until it is answered. Geometry only; colours are theme roles. */

body
{
    display: block;
    width: 100%;
    height: 100%;
    font-family: Inter;
    font-size: 13dp;
}

#scrim
{
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

#prompt
{
    overscroll-behavior: contain;
    display: block;
    position: absolute;
    left: 50%;
    top: 30%;
    width: 440dp;
    margin-left: -220dp;
    padding: 14dp 16dp;
    border-width: 1dp;
    border-radius: 5dp;
}

#title
{
    display: block;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 12dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

#message { display: block; margin-top: 8dp; }

#field
{
    display: block;
    box-sizing: border-box;
    width: 100%;
    margin-top: 10dp;
    height: 24dp;
    padding: 0dp 6dp;
    border-width: 1dp;
    border-radius: 3dp;
    font-family: "JetBrains Mono";
    font-size: 12dp;
}

#items { display: block; margin-top: 6dp; }
.item { display: block; padding-left: 12dp; line-height: 20dp; }

#choices
{
    display: flex;
    justify-content: flex-end;
    gap: 8dp;
    margin-top: 16dp;
}

.choice
{
    display: block;
    height: 26dp;
    line-height: 24dp;
    padding: 0dp 12dp;
    border-width: 1dp;
    border-radius: 3dp;
    font-family: "Chakra Petch";
    font-weight: 600;
    font-size: 11dp;
    letter-spacing: 0.5dp;
    text-transform: uppercase;
    tab-index: auto;
}
