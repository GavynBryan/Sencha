<rml>
<head>
    <title>Content Picture</title>
    <link type="text/rcss" href="content_picture.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<body data-model="content_picture">
    <!-- The picture a workspace renders, where the window keeps its content.
         The pixels are the host's; the document only places them, and the
         frames the host marks on them. Everything is in pixels from the
         content's corner. -->
    <div id="content" data-style-left="left" data-style-top="top" data-style-width="width" data-style-height="height">
        <img id="picture" data-if="image != ''" data-attr-src="'host:' + image"
             data-style-left="picture_left" data-style-top="picture_top"
             data-style-width="picture_width" data-style-height="picture_height"/>
        <!-- parts: left, top, width, height. -->
        <div class="frame theme-frame" data-for="frame : frames"
             data-class-active="frame.detail == 'selected'" data-class-hover="frame.detail == 'hover'"
             data-class-caution="frame.detail == 'caution'" data-class-faint="frame.value == 'faint'"
             data-style-left="frame.parts[0]" data-style-top="frame.parts[1]"
             data-style-width="frame.parts[2]" data-style-height="frame.parts[3]"></div>
    </div>
</body>
</rml>
