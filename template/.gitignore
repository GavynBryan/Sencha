# The game module build tree.
/build/

# Cook output: regenerated from authored content by the editor Cook / cook path.
/assets/.cooked/

# Except the three-room traversal world, which is committed cooked so that
# hosting a multi-zone session from a fresh clone is one command rather than a
# cook step first. Small, and regenerated by TraversalWorld.Generate.
!/assets/.cooked/worlds/traversal3.sworld.json
!/assets/.cooked/levels/_world-generations/traversal3/**
/assets/asset_ids.json

# Per-user editor view state (world focus/open/visible), never content.
*.sworld.user.json
