fn bob_offset frame=9 args=3 rets=1
     0: MULF    r3, r0, r1
     1: LDC     r4, k0 = 0x401921FB54442D18 (6.28319)
     2: MULF    r5, r3, r4
     3: MOV     r6, r5
     4: HCALL   r6, core.sin, argc=1
     5: MULF    r7, r6, r2
     6: RNDF32  r8, r7
     7: RETV    r8, n=1
fn Bob.fixed frame=14 args=3 rets=0
     0: MOV     r3, r0
     1: L2F     r4, r1
     2: RNDF32  r4, r4
     3: MULF    r5, r4, r2
     4: MOV     r6, r5
     5: CLD     r7, r3, BobMotion.base_height
     6: CLD     r8, r3, BobMotion.frequency
     7: CLD     r9, r3, BobMotion.amplitude
     8: MOV     r10, r6
     9: MOV     r11, r8
    10: MOV     r12, r9
    11: CALL    r10, bob_offset
    12: ADDF    r13, r7, r10
    13: CST     r3, r13, Transform.local.position.y
    14: RET     
