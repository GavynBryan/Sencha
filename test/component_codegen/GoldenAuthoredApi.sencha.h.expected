    static_assert(IsAuthoredArgumentType<EntityId>,
                  "test/component_codegen/GoldenAuthoredApi.h:171: SENCHA_VERB(\"test.bench.touch\"): parameter 'target' has type 'EntityId', which is not an authored argument type");
    static_assert(IsAuthoredArgumentType<EntityId>,
                  "test/component_codegen/GoldenAuthoredApi.h:178: SENCHA_VERB(\"test.bench.paint\"): parameter 'target' has type 'EntityId', which is not an authored argument type");
    static_assert(IsAuthoredArgumentType<std::string_view>,
                  "test/component_codegen/GoldenAuthoredApi.h:179: SENCHA_VERB(\"test.bench.paint\"): parameter 'label' has type 'std::string_view', which is not an authored argument type");
    static_assert(IsAuthoredArgumentType<AssetRef>,
                  "test/component_codegen/GoldenAuthoredApi.h:180: SENCHA_VERB(\"test.bench.paint\"): parameter 'decal' has type 'AssetRef', which is not an authored argument type");
    static_assert(IsAuthoredArgumentType<float>,
                  "test/component_codegen/GoldenAuthoredApi.h:181: SENCHA_VERB(\"test.bench.paint\"): parameter 'scale' has type 'float', which is not an authored argument type");
    static_assert(IsAuthoredArgumentType<int32_t>,
                  "test/component_codegen/GoldenAuthoredApi.h:182: SENCHA_VERB(\"test.bench.paint\"): parameter 'layer' has type 'int32_t', which is not an authored argument type");
    static_assert(requires(const GoldenBenchVerbs& provider) {
                      { provider.AuthoredWorld() } -> std::same_as<const World&>;
                  },
                  "test/component_codegen/GoldenAuthoredApi.h:171: a verb of 'GoldenBenchVerbs' takes a SENCHA_TARGET, so 'GoldenBenchVerbs' answers const World& AuthoredWorld() const, which the adapter asks whether the target is alive");

    static constexpr std::string_view Name_Touch = "test.bench.touch";
    static constexpr std::string_view Name_Paint = "test.bench.paint";

    static VerbDefinition Describe_Touch()
    {
