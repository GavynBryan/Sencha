                  "test/component_codegen/GoldenAuthoredApi.h:201: SENCHA_EVENT(\"test.torch.lit\"): member 'Instigator' has type 'EntityId', which is not an authored result type");
    static_assert(IsAuthoredResultType<GoldenLamp>,
                  "test/component_codegen/GoldenAuthoredApi.h:205: SENCHA_EVENT(\"test.torch.lit\"): member 'Brightness' has type 'GoldenLamp', which is not an authored result type");
    static_assert(AuthoredComponentType<GoldenTorch>,
                  "test/component_codegen/GoldenAuthoredApi.h:198: SENCHA_EVENT(\"test.torch.lit\"): SENCHA_EVENT_SOURCE(GoldenTorch) names a type that is not a component");

    static constexpr std::string_view EventName = "test.torch.lit";

    static AuthoredEventDefinition DescribeEvent()
    {
        AuthoredEventDefinition definition;
        definition.Name = "test.torch.lit";
        definition.DisplayName = "Lit";
        definition.SourceComponent = AuthoredComponentIdentity<GoldenTorch>();
        {
            DataFieldSchema member;
            member.Key = "instigator";
            AuthoredValueTraits<EntityId>::Describe(member);
            definition.Payload.Children.push_back(std::move(member));
        }
        {
            DataFieldSchema member;
            member.Key = "brightness";
            member.DisplayName = "Brightness";
            AuthoredValueTraits<GoldenLamp>::Describe(member);
            definition.Payload.Children.push_back(std::move(member));
