    static VerbDefinition Describe_Paint()
    {
        VerbDefinition definition;
        definition.Name = "test.bench.paint";
        {
            DataFieldSchema field;
            field.Key = "target";
            AuthoredValueTraits<EntityId>::Describe(field);
            definition.Arguments.Children.push_back(std::move(field));
        }
        {
            DataFieldSchema field;
            field.Key = "label";
            AuthoredValueTraits<std::string_view>::Describe(field);
            definition.Arguments.Children.push_back(std::move(field));
        }
        {
            DataFieldSchema field;
            field.Key = "decal";
            AuthoredValueTraits<AssetRef>::Describe(field);
            AuthoredValueField(field).Reference.AssetTypeFilter = AssetType::Texture;
            definition.Arguments.Children.push_back(std::move(field));
        }
        {
            DataFieldSchema field;
            field.Key = "scale";
            AuthoredValueTraits<float>::Describe(field);
            definition.Arguments.Children.push_back(std::move(field));
        }
        {
            DataFieldSchema field;
            field.Key = "layer";
            AuthoredValueTraits<int32_t>::Describe(field);
            definition.Arguments.Children.push_back(std::move(field));
        }
        return definition;
    }

    static VerbAnswer Invoke_Paint(GoldenBenchVerbs& self, const VerbInvocation& invocation)
    {
        EntityId target{};
        if (!DecodeAuthoredArgument<EntityId>(self, invocation.Arguments->At(0), target))
            return VerbArgumentAnswer(VerbAdmission::InvalidArguments, 0);
        if (!AuthoredTargetAlive(self.AuthoredWorld(), target))
            return VerbArgumentAnswer(VerbAdmission::UnresolvedReference, 0);
        std::string_view label{};
        if (!DecodeAuthoredArgument<std::string_view>(self, invocation.Arguments->At(1), label))
            return VerbArgumentAnswer(VerbAdmission::InvalidArguments, 1);
        AuthoredHeldArgument<AssetRef> decal;
        if (!decal.Read(invocation.Arguments->At(2)))
            return VerbArgumentAnswer(VerbAdmission::InvalidArguments, 2);
