            return VerbArgumentAnswer(VerbAdmission::InvalidArguments, 3);
        int32_t layer{};
        if (!DecodeAuthoredArgument<int32_t>(self, invocation.Arguments->At(4), layer))
            return VerbArgumentAnswer(VerbAdmission::InvalidArguments, 4);
        return AnswerAuthoredVerb(self.Paint(std::move(target), std::move(label), decal.Get(), std::move(scale), std::move(layer)), invocation.Result);
    }

